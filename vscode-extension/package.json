{
  "name": "prompt-forge-vscode",
  "displayName": "Promptini AI Prompt Studio",
  "description": "Turn rough ideas in Tunisian Derja, Arabic, French, or English into clean, model-ready prompts for Claude, Gemini, ChatGPT, Copilot, and Cursor — right inside VS Code.",
  "version": "1.0.0",
  "pricing": "Free",
  "icon": "icon.png",
  "publisher": "BecherZribi",
  "galleryBanner": {
    "color": "#FAF9F6",
    "theme": "light"
  },
  "homepage": "https://github.com/Bechir02/promptini#readme",
  "bugs": {
    "url": "https://github.com/Bechir02/promptini/issues"
  },
  "qna": "marketplace",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bechir02/promptini.git"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "categories": [
    "Machine Learning",
    "Programming Languages"
  ],
  "keywords": [
    "prompt",
    "ai",
    "claude",
    "gemini",
    "copilot"
  ],
  "activationEvents": [
    "onView:promptiniView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "promptini-container",
          "title": "Promptini",
          "icon": "sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "promptini-container": [
        {
          "id": "promptiniView",
          "name": "Promptini",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "promptini.open",
        "title": "Promptini: Open App"
      },
      {
        "command": "promptini.stop",
        "title": "Promptini: Stop App"
      },
      {
        "command": "promptini.optimizeSelection",
        "title": "Promptini: Optimize Selection"
      },
      {
        "command": "promptini.optimizeSelectionApi",
        "title": "Promptini: Optimize Selection via API"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorHasSelection",
          "command": "promptini.optimizeSelection",
          "group": "1_modification"
        },
        {
          "when": "editorHasSelection",
          "command": "promptini.optimizeSelectionApi",
          "group": "1_modification"
        }
      ]
    },
    "configuration": {
      "title": "Promptini",
      "properties": {
        "promptini.mode": {
          "type": "string",
          "enum": [
            "cloud",
            "local"
          ],
          "default": "cloud",
          "description": "Whether to use the Hugging Face Cloud version or a local Python server."
        },
        "promptini.hfUrl": {
          "type": "string",
          "default": "https://becher-zribi-prompt-forge-rag.hf.space",
          "description": "The URL of your Hugging Face Space (if mode is set to cloud)."
        },
        "promptini.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to a Python interpreter for Local mode. Leave empty to auto-detect a .venv in the workspace, otherwise system python3 is used."
        },
        "promptini.apiUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Base URL of the Promptini FastAPI engine (api.py) for 'Optimize Selection via API'."
        },
        "promptini.apiModel": {
          "type": "string",
          "default": "general",
          "description": "Target model used by 'Optimize Selection via API'."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -p ./ --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.88.0",
    "@vscode/vsce": "^2.29.0",
    "typescript": "^5.6.0"
  }
}
